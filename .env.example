# Server
PORT=8080
APP_ENV=dev
APP_URL=http://localhost:8080

# Supabase Postgres (via PgBouncer, transaction mode)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Redis (Upstash in prod, local container in dev)
REDIS_URL=redis://localhost:6379

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# PII encryption: 64 hex chars = 32-byte AES-256-GCM key (openssl rand -hex 32)
PII_KEY=

# OpenTelemetry → Grafana Cloud (leave empty for no-op local tracing)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Mail: Resend in prod, Mailpit (localhost:1025) locally
RESEND_API_KEY=
SMTP_ADDR=localhost:1025
MAIL_FROM=go-saas <no-reply@go-saas.local>
